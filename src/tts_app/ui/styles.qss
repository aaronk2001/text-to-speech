/* Graphite — flat, monochrome, one warm accent (#e0a458) used sparingly.
   No per-widget backgrounds: only top-level windows/popups paint a fill,
   so labels and containers never draw boxes behind text. */

QWidget {
    color: #ededed;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 14px;
}
QMainWindow, QDialog {
    background-color: #121212;
}

QFrame[role="hairline"] {
    background-color: #242424;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* === Labels === */
QLabel[role="wordmark"] {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #ededed;
}
QLabel[role="sectionHeading"] {
    font-size: 13px;
    font-weight: 600;
    color: #a3a3a3;
}
QLabel[role="bodyMuted"] { color: #8a8a8a; font-size: 13px; }
QLabel[role="status"] { color: #6b6b6b; font-size: 13px; }
QLabel[role="timecode"] {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #8a8a8a;
}
QLabel[role="paramValue"] {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #a3a3a3;
}

/* === Buttons === */
QPushButton {
    background-color: #1f1f1f;
    color: #ededed;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}
QPushButton:hover { background-color: #2a2a2a; }
QPushButton:pressed { background-color: #1a1a1a; }
QPushButton:disabled { color: #4d4d4d; background-color: #181818; }

QPushButton[role="primary"] {
    background-color: #ededed;
    color: #121212;
    font-weight: 600;
    padding: 8px 18px;
}
QPushButton[role="primary"]:hover { background-color: #ffffff; }
QPushButton[role="primary"]:disabled { background-color: #2a2a2a; color: #5c5c5c; }

/* Text-only button: reads as a link-ish action, gains a faint fill on hover */
QPushButton[role="ghost"] {
    background-color: transparent;
    color: #a3a3a3;
    padding: 6px 10px;
    border-radius: 6px;
}
QPushButton[role="ghost"]:hover { color: #ededed; background-color: rgba(255, 255, 255, 0.05); }
QPushButton[role="ghost"]:disabled { color: #4d4d4d; background-color: transparent; }

QPushButton[role="icon"] {
    background-color: transparent;
    border-radius: 6px;
    padding: 4px;
}
QPushButton[role="icon"]:hover { background-color: rgba(255, 255, 255, 0.05); }

QPushButton[role="enginePill"] {
    background-color: transparent;
    color: #7a7a7a;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
}
QPushButton[role="enginePill"]:hover { color: #ededed; }
QPushButton[role="enginePill"]:checked {
    color: #ededed;
    background-color: #242424;
}

QPushButton[role="transport"] {
    background-color: transparent;
    color: #a3a3a3;
    border-radius: 20px;
    padding: 0;
    font-size: 13px;
    min-width: 40px;
    min-height: 40px;
}
QPushButton[role="transport"]:hover { color: #ededed; background-color: rgba(255, 255, 255, 0.05); }
QPushButton[role="transport"]:disabled { color: #3d3d3d; background-color: transparent; }

QPushButton[role="play"] {
    background-color: #ededed;
    color: #121212;
    border-radius: 22px;
    padding: 0 26px;
    min-height: 44px;
    min-width: 72px;
    font-weight: 600;
}
QPushButton[role="play"]:hover { background-color: #ffffff; }
QPushButton[role="play"]:disabled { background-color: #2a2a2a; color: #6b6b6b; }

QPushButton[role="paramReset"] {
    background-color: transparent;
    color: #6b6b6b;
    border-radius: 9px;
    padding: 0;
    font-size: 12px;
}
QPushButton[role="paramReset"]:hover { color: #ededed; }

/* Voice picker: plain text with a caret, no field chrome */
QPushButton[role="voicePicker"] {
    background-color: transparent;
    color: #ededed;
    text-align: left;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 14px;
}
QPushButton[role="voicePicker"]:hover { background-color: rgba(255, 255, 255, 0.05); }

/* === Combo box === */
QComboBox {
    background-color: #1f1f1f;
    color: #ededed;
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
}
QComboBox:hover { background-color: #2a2a2a; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8a8a8a;
    width: 0;
    height: 0;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    color: #ededed;
    border: 1px solid #2a2a2a;
    padding: 4px;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: none;
}

/* === Text inputs === */
QPlainTextEdit, QTextEdit {
    background-color: transparent;
    color: #ededed;
    border: none;
    padding: 0;
    font-size: 17px;
    selection-background-color: rgba(224, 164, 88, 0.30);
    selection-color: #ffffff;
}
QLineEdit {
    background-color: #1a1a1a;
    color: #ededed;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 7px 12px;
    selection-background-color: rgba(224, 164, 88, 0.30);
}
QLineEdit:focus { border-color: #4d4d4d; }
QLineEdit[role="paletteSearch"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #242424;
    border-radius: 0;
    padding: 16px 20px;
    font-size: 16px;
}

/* === Sliders === */
QSlider { background: transparent; }
QSlider::groove:horizontal { height: 2px; background: #2e2e2e; border-radius: 1px; }
QSlider::sub-page:horizontal { background: #d4d4d4; border-radius: 1px; }
QSlider::add-page:horizontal { background: #2e2e2e; border-radius: 1px; }
QSlider::handle:horizontal {
    background: #ededed;
    border: none;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover { background: #ffffff; }

/* === Status bar === */
QStatusBar {
    background-color: #121212;
    color: #6b6b6b;
    font-size: 12px;
}
QStatusBar QLabel { color: #5c5c5c; font-size: 12px; padding: 0 0 8px 24px; }
QStatusBar::item { border: none; }

/* === Tabs === */
QTabWidget::pane { background: transparent; border: none; border-top: 1px solid #242424; top: -1px; padding-top: 8px; }
QTabBar::tab {
    background: transparent;
    color: #7a7a7a;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
}
QTabBar::tab:hover { color: #ededed; }
QTabBar::tab:selected { color: #ededed; border-bottom-color: #ededed; }

/* === Lists / trees === */
QTreeWidget, QTreeView, QListView {
    background-color: transparent;
    color: #d4d4d4;
    border: none;
    alternate-background-color: #161616;
    selection-background-color: #242424;
    selection-color: #ffffff;
    outline: none;
}
QTreeWidget::item, QTreeView::item, QListView::item { padding: 7px 6px; border: none; border-radius: 6px; }
QTreeWidget::item:hover, QTreeView::item:hover, QListView::item:hover { background-color: rgba(255, 255, 255, 0.04); }
QTreeWidget::item:selected, QTreeView::item:selected, QListView::item:selected { background-color: #242424; color: #ffffff; }
QHeaderView::section {
    background-color: transparent;
    color: #7a7a7a;
    border: none;
    border-bottom: 1px solid #242424;
    padding: 6px 8px;
    font-size: 12px;
}

/* === Progress bar === */
QProgressBar {
    background-color: #242424;
    border: none;
    border-radius: 2px;
    color: transparent;
    min-height: 4px;
    max-height: 4px;
}
QProgressBar::chunk { background-color: #ededed; border-radius: 2px; }

/* === Menus === */
QMenuBar { background-color: #121212; color: #d4d4d4; }
QMenuBar::item { padding: 6px 10px; background: transparent; }
QMenuBar::item:selected { background-color: #1f1f1f; }
QMenu {
    background-color: #1a1a1a;
    color: #d4d4d4;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 7px 16px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background-color: #262626; color: #ffffff; }
QMenu::separator { height: 1px; background: #2a2a2a; margin: 4px 6px; }
QMenu::indicator { width: 12px; height: 12px; margin-left: 4px; }

/* === Scrollbars === */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #2e2e2e; border-radius: 4px; min-height: 24px; margin: 1px; }
QScrollBar::handle:vertical:hover { background: #4d4d4d; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { background: none; height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #2e2e2e; border-radius: 4px; min-width: 24px; margin: 1px; }
QScrollBar::handle:horizontal:hover { background: #4d4d4d; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { background: none; width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QGroupBox {
    border: none;
    margin-top: 22px;
    padding: 4px 0 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #a3a3a3;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0; }

QToolTip {
    background-color: #242424;
    color: #ededed;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
}

QDialog#voicePalette {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

QFrame[role="voicePopup"] {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
}
QFrame[role="voicePopup"] QLineEdit { background-color: #121212; font-size: 13px; }
